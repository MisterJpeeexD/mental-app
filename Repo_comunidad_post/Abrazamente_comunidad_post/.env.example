# ==========================================
# AbrazaMente - Variables de Entorno (.env)
# ==========================================

# --- Base de datos ---
# Desarrollo Local (H2 DB en memoria por defecto):
DB_URL=jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# Producción (Neon PostgreSQL):
# Descomenta y sustituye con las credenciales entregadas por Neon Tech en Render
# DB_URL=jdbc:postgresql://ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DB_USER=neondb_owner
# DB_PASSWORD=tu_password_de_neon
# DB_DRIVER=org.postgresql.Driver

# --- Hibernate / JPA ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Seguridad JWT ---
# Genera un secreto propio para producción con: openssl rand -base64 48
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# --- OAuth2 / Google (Opcional) ---
GOOGLE_CLIENT_ID=

# --- CORS / Orígenes Permitidos ---
# Separados por coma (sin barra final). En Render añade la URL del frontend estático o mismo dominio.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Puerto de Servicio ---
# Render asigna la variable PORT automáticamente. En local usa 8080.
PORT=8080

# --- Frontend (Vite API base URL) ---
# Dejar vacío si el frontend se entrega estáticamente embebido dentro de Spring Boot.
VITE_API_URL=
