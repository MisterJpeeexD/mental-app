# --- Base de datos ---
# Local (docker-compose):
DB_URL=jdbc:postgresql://localhost:5432/db
DB_USER=postgres
DB_PASSWORD=postgres123
# Neon (producción): copia la "Connection string" del panel de Neon y agrega
# ?sslmode=require al final. Ejemplo:
# DB_URL=jdbc:postgresql://ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require
# DB_USER=neondb_owner
# DB_PASSWORD=<password entregado por Neon>

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Genera un valor propio con: openssl rand -base64 48
JWT_SECRET=y1H7DdSnU33Ra1SwhvhSmBm4jS1ANrKLOpMNVps61+gA1PfEbJnoBDN5ZR/UBzbX
JWT_EXPIRATION=3600000

# Orígenes permitidos por CORS, separados por coma (sin barra final).
# En Render agrega la URL pública del frontend, ej:
# FRONTEND_ORIGINS=http://localhost:5173,https://abrazamente-frontend.onrender.com
FRONTEND_ORIGINS=http://localhost:5173

# Puerto HTTP del backend. Render inyecta PORT automáticamente; no es necesario
# definirlo a mano en el dashboard, solo déjalo tal cual para ejecución local.
PORT=8080

# --- Frontend (Vite) ---
# URL pública del backend cuando el frontend se despliega por separado
# (Render Static Site, Vercel, Netlify). Vacío = mismo origen (build embebido en Spring Boot).
# VITE_API_URL=https://abrazamente-backend.onrender.com
VITE_API_URL=
